{
  "private": true,
  "name": "med3pa-app",
  "description": "Standalone MED3pa application — predictive performance precision analysis",
  "version": "0.1.0",
  "author": "MEDomicsLab Team",
  "main": "app/background.js",
  "scripts": {
    "build:go": "cd go_server && go build main.go",
    "dev": "npm run build:go && nextron --renderer-port 8899",
    "dev:linux": "npm run build:go && nextron --renderer-port 8899",
    "lint": "next lint --dir renderer",
    "verify": "cd renderer && cross-env NEXT_DIST_DIR=.next-verify next build",
    "build": "nextron build",
    "build:linux": "bash ./utilScripts/build_preparation_linux.sh && nextron build --linux",
    "build:win": ".\\utilScripts\\build_preparation_win.bat && nextron build --win",
    "build:mac": "bash ./utilScripts/build_preparation_mac.sh && nextron build --mac"
  },
  "dependencies": {
    "@khalidalansi/use-interval": "^1.0.3",
    "axios": "^1.3.3",
    "d3": "^7.8.5",
    "directory-tree": "^3.5.1",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "electron-log": "^5.3.0",
    "electron-serve": "^1.1.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.2.0",
    "mongodb": "^6.6.2",
    "mongodb-client-encryption": "^6.1.0",
    "papaparse": "^5.4.1",
    "primeicons": "^7.0.0",
    "primereact": "^9.6.2",
    "react-bootstrap-icons": "^1.10.3",
    "react-toastify": "^9.1.1",
    "react-loading": "^2.0.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.3",
    "@electron/notarize": "^2.5.0",
    "@electron/osx-sign": "^2.0.0",
    "@next/eslint-plugin-next": "^14.0.2",
    "bootstrap": "^5.2.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "electron": "^21.4.4",
    "electron-builder": "^26.0.11",
    "electron-extension-installer": "^1.2.0",
    "eslint": "^8.44.0",
    "eslint-config-next": "^13.5.3",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.32.2",
    "next": "^13.5.3",
    "nextron": "^8.5.0",
    "prettier": "^3.4.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.1",
    "react-dom": "^18.2.0"
  }
}
